{
  "name": "poro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check": "npm run type-check",
    "guard:private": "bash ./scripts/guard-private-assets.sh",
    "harness:build": "cargo build -p harness-server --manifest-path ../harness/Cargo.toml",
    "tauri": "npm run harness:build && tauri dev -c ./tauri/tauri.conf.json",
    "tauri:dev": "npm run harness:build && tauri dev -c ./tauri/tauri.conf.json",
    "tauri:build": "npm run harness:build && tauri build -c ./tauri/tauri.conf.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^25.5.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.8"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.2.10",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.0"
  }
}
